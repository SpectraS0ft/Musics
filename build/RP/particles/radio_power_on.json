{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "spectra:radio_power_on",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/wave"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 18
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [0, 0.35, 0],
        "radius": 0.25,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.35, 0.7)"
      },
      "minecraft:particle_initial_speed": "math.random(1.5, 3.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 0.5, 0],
        "linear_drag_coefficient": 3.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.06 + (1.0 - v.particle_age / v.particle_lifetime) * 0.1",
          "0.06 + (1.0 - v.particle_age / v.particle_lifetime) * 0.1"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [0, 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.2": "#FF00FF88",
            "0.6": "#FFFFD700",
            "1.0": "#00FFAA00"
          }
        }
      }
    }
  }
}
