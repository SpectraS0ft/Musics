{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "spectra:radio_notes",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/note"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [0, 0.2, -0.15],
        "radius": 0.15,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.2, 2.0)"
      },
      "minecraft:particle_initial_speed": "math.random(0.4, 1.0)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-40, 40)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.random(-0.3, 0.3)",
          "math.random(0.6, 1.4)",
          "math.random(-0.3, 0.3)"
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.12 + variable.particle_random_1 * 0.06",
          "0.12 + variable.particle_random_1 * 0.06"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [0, 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFE14A",
            "0.4": "#FFFF6BCB",
            "0.7": "#FF7EC8FF",
            "1.0": "#00FFFFFF"
          }
        }
      }
    }
  }
}
