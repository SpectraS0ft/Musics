{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "spectra:radio_speaker",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/wave"
      }
    },
    "components": {
